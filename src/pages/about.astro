---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKEDIN_URL, X_URL } from '../lib/site';
import { withBasePath } from '../lib/paths';
import { getProfile } from '../lib/profile';
import { createPersonJsonLd, createProfilePageJsonLd } from '../lib/structured-data';
import IconLinkedIn from '../components/icons/IconLinkedIn.astro';
import IconX from '../components/icons/IconX.astro';

const profile = await getProfile();
const pageDescription = profile.data.aboutDescription;
const structuredData = [
  createPersonJsonLd(profile),
  createProfilePageJsonLd(profile, '/about/', pageDescription),
];
---

<BaseLayout
  title="About"
  description={pageDescription}
  structuredData={structuredData}
  pageClass="page-about"
>
  <article class="personal-about">
    <header class="personal-intro">
      <div class="personal-intro__portrait">
      <img
        src={withBasePath('/images/mahesh-editorial-v2.webp')}
        alt={profile.data.name}
        class="personal-intro__photo"
        width="720"
        height="900"
        fetchpriority="high"
      />
      </div>
      <div class="personal-intro__copy">
        <h1>A little about me.</h1>
        <p class="personal-intro__lead">I’m Mahesh, an architect in SAP’s Office of the CTO. I work on enterprise AI, SAP BTP, and turning ideas into systems people can use.</p>
      <div class="personal-social" aria-label="Social links">
        <a href={LINKEDIN_URL} target="_blank" rel="noreferrer">
          <IconLinkedIn size={18} />
          <span>LinkedIn</span>
        </a>
        <a href={X_URL} target="_blank" rel="noreferrer">
          <IconX size={18} />
          <span>X (Twitter)</span>
        </a>
      </div>
      </div>
    </header>
    <div class="personal-story about-story">
      <section class="about-story__section">
        <h2>What I’m working on</h2>
        <div>
          <p>These days, much of my work is around enterprise AI, SAP BTP, data, and agentic systems—especially moving AI-native ideas beyond demos into real enterprise systems.</p>
          <p>I collaborate with teams across lines of business, partners, and AI-native companies on scalable capabilities, reference patterns, and architecture direction.</p>
        </div>
      </section>
      <section class="about-story__section">
        <h2>My background</h2>
        <div>
          <p>Over the last 13+ years, I’ve designed and delivered enterprise applications across SAP platforms, AI ecosystems, and hyperscaler environments.</p>
          <p>I’ve worked with global enterprises, including Fortune 50 customers, on enterprise architecture, SAP platforms, and AI adoption.</p>
        </div>
      </section>
      <section class="about-story__section">
        <h2>Writing and sharing</h2>
        <div>
        <p>I speak at community and industry events, write for SAP PRESS, and have published 40+ posts on SAP Community.</p>
        <p>This site brings together my writing, talks, and practical notes on enterprise architecture, coding, AI, and SAP.</p>
        <div class="personal-social">
          <a class="personal-link" href={withBasePath('/blog/')}>Read my writing <span aria-hidden="true">→</span></a>
          <a class="personal-link" href={withBasePath('/speaking/')}>Explore my talks <span aria-hidden="true">→</span></a>
        </div>
        </div>
      </section>
      <aside class="personal-disclaimer">
          <p>
            All opinions and content on this site are my own and do not represent the views of my
            employer.
          </p>
      </aside>
    </div>
  </article>
</BaseLayout>
