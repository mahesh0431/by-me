---
import RecentEntryCard from '../components/home/RecentEntryCard.astro';
import { withBasePath } from '../lib/paths';
import { getBlogPosts, getPostRouteSlug } from '../lib/blog';
import { formatDate } from '../lib/dates';
import { getProfile } from '../lib/profile';
import { getSpeakingEntries, getSpeakingRouteSlug } from '../lib/speaking';
import { createPersonJsonLd, createWebSiteJsonLd } from '../lib/structured-data';
import BaseLayout from '../layouts/BaseLayout.astro';

const profile = await getProfile();
const recentPosts = (await getBlogPosts())
  .filter((post) => !post.data.tags?.includes('archive'))
  .map((post) => ({
    kind: 'post' as const,
    title: post.data.title,
    summary: post.data.summary,
    href: withBasePath(`/blog/${getPostRouteSlug(post)}/`),
    date: post.data.created,
    meta: 'Blog',
  }));
const recentSpeaking = (await getSpeakingEntries()).map((entry) => ({
  kind: 'speaking' as const,
  title: entry.data.title,
  summary: entry.data.summary,
  href: withBasePath(`/speaking/${getSpeakingRouteSlug(entry)}/`),
  date: entry.data.created,
  meta: entry.data.event,
}));
const recentEntries = [...recentPosts, ...recentSpeaking]
  .sort((left, right) => right.date.getTime() - left.date.getTime())
  .slice(0, 5);
const pageDescription =
  'Mahesh Palavalli is an architect in SAP’s Office of the CTO, writing about enterprise architecture, coding, AI, SAP BTP, agentic systems, and real-world enterprise systems.';
---

<BaseLayout
  title={profile.data.name}
  description={pageDescription}
  structuredData={[createWebSiteJsonLd(), createPersonJsonLd(profile)]}
  pageClass="page-home"
>
  <section class="personal-intro" aria-labelledby="welcome-title">
    <div class="personal-intro__portrait">
      <img
        src={withBasePath('/images/mahesh-editorial-v2.webp')}
        alt={profile.data.name}
        class="personal-intro__photo"
        width="720"
        height="900"
        fetchpriority="high"
      />
    </div>

    <div class="personal-intro__copy">
      <h1 id="welcome-title">{profile.data.homeHeading}.</h1>
      <p class="personal-intro__lead">
        Architect in SAP’s Office of the CTO. I work on enterprise AI and SAP BTP,
        and write about what it takes to turn ideas into working systems.
      </p>
        <a class="personal-link" href={withBasePath('/about/')}>
          More about me
          <span aria-hidden="true">&rarr;</span>
        </a>
    </div>
  </section>

  <section class="home-recent" aria-labelledby="recent-title">
  <header class="section-head">
    <div>
      <h2 class="section-title" id="recent-title">Recent</h2>
      <p class="section-kicker">Ideas, lessons, and conversations from my work.</p>
    </div>
  </header>

  <section class="recent-list entry-list--home">
    {recentEntries.map((entry, index) => (
      <RecentEntryCard
        kind={entry.kind}
        title={entry.title}
        summary={entry.summary}
        href={entry.href}
        dateLabel={formatDate(entry.date)}
        dateIso={entry.date.toISOString()}
        meta={entry.meta}
        index={index}
      />
    ))}
  </section>
  </section>
</BaseLayout>
