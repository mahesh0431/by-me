---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import GiscusComments from "../components/blog/GiscusComments.astro";
import PostMeta from "../components/blog/PostMeta.astro";
import { getHeroWidths, getSocialImageSrc } from "../lib/hero-image";
import { withBasePath } from "../lib/paths";
import { getProfile } from "../lib/profile";
import { getReadingTimeLabel } from "../lib/reading-time";
import { DEFAULT_OG_IMAGE } from "../lib/site";
import { createBlogPostingJsonLd, createPersonJsonLd } from "../lib/structured-data";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const profile = await getProfile();
const heroImage = post.data.heroImage;
const socialImage = heroImage ? await getSocialImageSrc(heroImage) : DEFAULT_OG_IMAGE;
const pageTitle = post.data.seoTitle ?? post.data.title;
const pageDescription = post.data.seoDescription ?? post.data.summary;
const readingTime = getReadingTimeLabel(post.body);
const articleModifiedTime = (post.data.updated ?? post.data.created).toISOString();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={socialImage}
  ogImageAlt={post.data.title}
  ogType="article"
  canonicalUrl={post.data.canonicalUrl}
  articlePublishedTime={post.data.created.toISOString()}
  articleModifiedTime={articleModifiedTime}
  articleTags={post.data.tags}
  structuredData={[createPersonJsonLd(profile), createBlogPostingJsonLd(post, profile, { imageUrl: socialImage })]}
  pageClass="page-article"
  showScrollControls
>
  <article class="article-shell">
    <div class="article-frame surface">
      <header class="article-hero">
        <a class="back-link" href={withBasePath('/blog/')}>All writing</a>
        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-lead">{post.data.summary}</p>
        <PostMeta
          created={post.data.created}
          updated={post.data.updated}
          tags={post.data.tags}
          readingTime={readingTime}
        />
        {
          heroImage && (
            <Image
              class="article-hero-media"
              src={heroImage}
              alt={`${post.data.title} hero image`}
              widths={getHeroWidths(heroImage)}
              sizes="(max-width: 1024px) calc(100vw - 2rem), 64rem"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </header>
      <section class="article-content">
        <slot />
      </section>
      <GiscusComments />
    </div>
  </article>
</BaseLayout>
